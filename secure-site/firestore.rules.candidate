rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember() { return signedIn() && request.auth.token.area == "member"; }
    function isGeneral() { return signedIn() && request.auth.token.area == "general"; }
    function isAdmin() { return signedIn() && request.auth.token.area == "admin"; }
    function canUseGeneralArea() { return isMember() || isGeneral() || isAdmin(); }

    // Member-area data: member and admin roles.
    match /events/{id} { allow read, write: if isMember() || isAdmin(); }
    match /calendar_settings/{id} { allow read, write: if isMember() || isAdmin(); }
    match /kuji_history/{id} { allow read, write: if isMember() || isAdmin(); }
    match /kuji_settings/{id} { allow read, write: if isMember() || isAdmin(); }
    match /memos/{id} { allow read, write: if isMember() || isAdmin(); }
    match /memo_images/{id} { allow read, write: if isMember() || isAdmin(); }
    match /plunders/{id} { allow read, write: if isMember() || isAdmin(); }
    match /plunder_templates/{id} { allow read, write: if isMember() || isAdmin(); }

    // General-area data: member users can also read and edit it.
    // General-only users remain isolated from member-area collections.
    match /general_polls/{id} { allow read, write: if canUseGeneralArea(); }
    match /general_memos/{id} { allow read, write: if canUseGeneralArea(); }
    match /general_calendar/{id} { allow read, write: if canUseGeneralArea(); }

    // Admin-only non-secret settings.
    match /admin_config/{id} { allow read, write: if isAdmin(); }

    // Deny all unlisted collections.
    match /{document=**} { allow read, write: if false; }
  }
}