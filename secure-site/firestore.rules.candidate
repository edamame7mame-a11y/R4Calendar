rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember() { return signedIn() && request.auth.token.area == "member"; }
    function isAdmin() { return signedIn() && request.auth.token.area == "admin"; }

    // All eight collections in the inspected 2026-11-10 backup currently
    // belong to the member area. General-area data has not been specified yet.
    function canUseMemberData() { return isMember() || isAdmin(); }

    match /events/{id} { allow read, write: if canUseMemberData(); }
    match /calendar_settings/{id} { allow read, write: if canUseMemberData(); }
    match /kuji_history/{id} { allow read, write: if canUseMemberData(); }
    match /kuji_settings/{id} { allow read, write: if canUseMemberData(); }
    match /memos/{id} { allow read, write: if canUseMemberData(); }
    match /memo_images/{id} { allow read, write: if canUseMemberData(); }
    match /plunders/{id} { allow read, write: if canUseMemberData(); }
    match /plunder_templates/{id} { allow read, write: if canUseMemberData(); }

    // Reserved for non-secret admin settings only.
    match /admin_config/{id} { allow read, write: if isAdmin(); }

    // No general-area collection is granted access until its actual
    // pages, purpose, and document schema are agreed and tested.
    // Deny all unlisted collections.
    match /{document=**} { allow read, write: if false; }
  }
}
